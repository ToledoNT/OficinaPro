generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workshop {
  id         String           @id @default(uuid())
  name       String
  cnpj       String?
  phone      String?
  address    String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  budgets    Budget[]
  clients    Client[]
  histories  ServiceHistory[]
  users      User[]
  vehicles   Vehicle[]
  workOrders WorkOrder[]

  @@map("workshops")
}

model User {
  id                  String           @id @default(uuid())
  name                String
  email               String           @unique
  passwordHash        String
  role                UserRole         @default(ADMIN)
  status              UserStatus       @default(ATIVO)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  workshopId          String
  budgetsCreated      Budget[]
  servicesResponsible ServiceHistory[]
  workshop            Workshop         @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  workOrders          WorkOrder[]

  @@index([workshopId])
  @@map("users")
}

model Client {
  id         String      @id @default(uuid())
  name       String
  cpf        String?
  phone      String
  email      String?
  address    String?
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  workshopId String
  budgets    Budget[]
  workshop   Workshop    @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  vehicles   Vehicle[]
  workOrders WorkOrder[]

  @@unique([workshopId, cpf])
  @@index([workshopId])
  @@index([name])
  @@index([cpf])
  @@index([phone])
  @@map("clients")
}

model Vehicle {
  id         String           @id @default(uuid())
  type       VehicleType      @default(CARRO)
  brand      String?
  model      String?
  year       Int?
  plate      String?
  mileage    Int              @default(0)
  color      String?
  chassis    String?
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  clientId   String
  workshopId String
  budgets    Budget[]
  history    ServiceHistory[]
  client     Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workshop   Workshop         @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  workOrders WorkOrder[]

  @@unique([workshopId, plate])
  @@index([workshopId])
  @@index([plate])
  @@index([model])
  @@index([clientId])
  @@index([type])
  @@map("vehicles")
}

model ServiceHistory {
  id              String   @id @default(uuid())
  date            DateTime @default(now())
  mileage         Int
  problemReported String
  diagnosis       String
  servicesDone    String
  partsUsed       String?
  notes           String?
  totalAmount     Decimal  @db.Decimal(10, 2)
  responsibleName String
  vehicleId       String
  userId          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  workshopId      String
  user            User?    @relation(fields: [userId], references: [id])
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  workshop        Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([workshopId])
  @@index([vehicleId])
  @@index([date])
  @@map("service_histories")
}

model Budget {
  id             String       @id @default(uuid())
  code           Int          @default(autoincrement())
  date           DateTime     @default(now())
  expirationDate DateTime
  status         BudgetStatus @default(RASCUNHO)
  notes          String?
  subtotal       Decimal      @default(0) @db.Decimal(10, 2)
  discount       Decimal      @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal      @default(0) @db.Decimal(10, 2)
  clientId       String
  vehicleId      String
  userId         String?
  workOrderId    String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  workshopId     String
  items          BudgetItem[]
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  workOrder      WorkOrder?   @relation(fields: [workOrderId], references: [id])
  workshop       Workshop     @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([workshopId])
  @@index([clientId])
  @@index([vehicleId])
  @@index([status])
  @@index([code])
  @@map("budgets")
}

model WorkOrder {
  id               String          @id @default(uuid())
  code             Int             @default(autoincrement())
  status           WorkOrderStatus @default(AGUARDANDO)
  problemReported  String
  diagnosis        String?
  servicesDone     String?
  partsUsed        String?
  notes            String?
  mileageIn        Int
  mileageOut       Int?
  estimatedAt      DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  totalAmount      Decimal         @default(0) @db.Decimal(10, 2)
  responsibleName  String?
  clientId         String
  vehicleId        String
  userId           String?
  serviceHistoryId String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  workshopId       String
  budget           Budget?
  client           Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user             User?           @relation(fields: [userId], references: [id])
  vehicle          Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  workshop         Workshop        @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([workshopId])
  @@index([clientId])
  @@index([vehicleId])
  @@index([status])
  @@index([code])
  @@map("work_orders")
}

model BudgetItem {
  id          String   @id @default(uuid())
  type        ItemType @default(SERVICO)
  description String
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(10, 2)
  discount    Decimal  @default(0) @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)
  budgetId    String
  createdAt   DateTime @default(now())
  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@map("budget_items")
}

enum UserRole {
  ADMIN
  MECANICO
  ATENDENTE
}

enum UserStatus {
  ATIVO
  INATIVO
}

enum VehicleType {
  CARRO
  MOTO
}

enum BudgetStatus {
  RASCUNHO
  ENVIADO
  APROVADO
  RECUSADO
  EXPIRADO
}

enum ItemType {
  SERVICO
  PECA
}

enum WorkOrderStatus {
  AGUARDANDO
  EM_EXECUCAO
  PAUSADO
  CONCLUIDO
  CANCELADO
}
